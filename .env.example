# Poseidon Environment Configuration
# Copy to .env and fill in real values

# API authentication key (required for all secured endpoints)
POSEIDON_API_KEY=change-me-to-a-real-secret

# FinMind API token (register at https://finmindtrade.com)
POSEIDON_FINMIND_TOKEN=your-finmind-token-here

# Thalassa data source (Phase 60: remote repository cutover)
# "local" = direct DB access (default), "remote" = Thalassa REST API
POSEIDON_DATA_SOURCE=local
POSEIDON_THALASSA_BASE_URL=http://macminim4:8001
POSEIDON_THALASSA_API_KEY=your-thalassa-api-key-here
