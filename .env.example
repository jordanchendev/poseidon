# Poseidon Environment Configuration
# Copy to .env and fill in real values

# API authentication key (required for all secured endpoints)
POSEIDON_API_KEY=change-me-to-a-real-secret
# Optional fixed decision-loop principals; map SHA-256 key fingerprints (64 lowercase
# hex characters) to actor_id, roles, and exact account_scopes. Never put raw keys here.
# Roles: researcher, portfolio_manager, release_manager, viewer, decision-worker.
# decision-worker cannot share human authority roles. These principals are accepted
# only by explicitly role-scoped endpoints; legacy routes still require API_KEY.
POSEIDON_API_PRINCIPALS_JSON={}

# FinMind API token (register at https://finmindtrade.com)
POSEIDON_FINMIND_TOKEN=your-finmind-token-here

# Thalassa data source (remote repository cutover from local DB)
# "local" = direct DB access (default), "remote" = Thalassa REST API
POSEIDON_DATA_SOURCE=local
POSEIDON_THALASSA_BASE_URL=http://macminim4:8001
POSEIDON_THALASSA_API_KEY=your-thalassa-api-key-here
