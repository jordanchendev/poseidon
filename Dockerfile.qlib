# Python 3.12 Qlib training worker image with pyqlib + mlflow.
#
# Why a separate image:
# - pyqlib 0.9.7 only ships cp312 wheels (no cp313 support).
# - Production containers (api, cpu-worker, gpu-worker, beat) run on Python 3.13
#   per the main Dockerfile, so pyqlib cannot be installed alongside them.
# - Per design D-19 (Phase 37), Qlib is an optional research dependency and
#   intentionally excluded from production containers.
#
# Phase 41 D-10: This image now runs as a long-lived Celery worker subscribing
# to qlib_queue (concurrency=1, pool=solo). The previous one-shot "research"
# profile approach has been replaced. MLflow is included as a direct dependency
# (D-14) for the metrics bridge — mlflow.get_run() metrics are scraped into
# training_runs.metrics JSONB after each training run.
#
# This image shares the same TimescaleDB connection as production containers,
# so DatasetBuilder reads from the live data layer with no duplication.

FROM python:3.12-slim

WORKDIR /app

# System dependencies — same as main Dockerfile (TA-Lib, postgres, build tools)
# pyqlib needs gcc + g++ to build cython extensions on first install.
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libc6-dev libpq-dev wget make && \
    wget -q https://github.com/ta-lib/ta-lib/releases/download/v0.6.4/ta-lib-0.6.4-src.tar.gz && \
    tar xzf ta-lib-0.6.4-src.tar.gz && \
    cd ta-lib-0.6.4 && ./configure --prefix=/usr && make -j$(nproc) && make install && \
    cd .. && rm -rf ta-lib-0.6.4 ta-lib-0.6.4-src.tar.gz && \
    rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Install poseidon + qlib extra. Use --no-dev because research env doesn't
# need pytest etc., and skip --frozen because we're on a different Python
# version than uv.lock was generated against (lock targets cp313).
COPY pyproject.toml uv.lock ./
RUN uv sync --extra qlib --no-dev --no-install-project

COPY src/ src/
RUN uv sync --extra qlib --no-dev --no-editable

# Plan 90-04.1: patch a known qlib v0.9.7 upstream bug in
# qlib/utils/index_data.py:to_series — it calls pd.Series(data, index=self.index)
# where self.index is a qlib.utils.index_data.Index object, not a pandas Index.
# Pandas's ensure_index() refuses to wrap it ("Index(...) must be called with
# a collection of some kind"). The same file's __repr__ method has the correct
# form `index=self.index.tolist()` two lines below — clearly a one-line bug
# in to_series. Fix it via sed at build time so we don't fork qlib.
# Verified manually 2026-05-05: this single patch unblocks qlib.rl.contrib.backtest
# all the way through SAOEIntStrategy + Exchange under pandas 2.x.
RUN sed -i 's|return pd.Series(self.data, index=self.index)|return pd.Series(self.data, index=self.index.tolist())|' \
        /app/.venv/lib/python3.12/site-packages/qlib/utils/index_data.py && \
    grep -q "return pd.Series(self.data, index=self.index.tolist())" \
        /app/.venv/lib/python3.12/site-packages/qlib/utils/index_data.py && \
    echo "qlib index_data.to_series patch applied OK"

# Plan 90-04.1: pandas 2.x dropped positional `axis` in pd.concat(); qlib v0.9.7
# still calls `pd.concat(..., 0)` in two places in qlib/rl/contrib/backtest.py.
# Patch both call sites to use keyword axis=0.
RUN sed -i 's|pd\.concat(record_list, 0)|pd.concat(record_list, axis=0)|' \
        /app/.venv/lib/python3.12/site-packages/qlib/rl/contrib/backtest.py && \
    sed -i 's|pd\.concat(\[r\[0\] for r in res\], 0)|pd.concat([r[0] for r in res], axis=0)|' \
        /app/.venv/lib/python3.12/site-packages/qlib/rl/contrib/backtest.py && \
    grep -q "pd.concat(record_list, axis=0)" \
        /app/.venv/lib/python3.12/site-packages/qlib/rl/contrib/backtest.py && \
    echo "qlib backtest.pd_concat patch applied OK"

COPY config/ config/
COPY alembic/ alembic/
COPY alembic.ini .

# Verify the install — fail the build if any component is broken.
RUN /app/.venv/bin/python -c "import qlib; print(f'qlib {qlib.__version__} OK')" && \
    /app/.venv/bin/python -c "import mlflow; print(f'mlflow {mlflow.__version__} OK')" && \
    /app/.venv/bin/python -c "from poseidon.qlib import check_qlib_available; assert check_qlib_available(), 'qlib bridge reports unavailable inside research image'; print('poseidon.qlib bridge OK')"

ENV PATH="/app/.venv/bin:$PATH"

# Default CMD is a Python REPL for ad-hoc research sessions.
# In production, docker-compose.yml overrides this with the Celery worker
# command: celery -A poseidon.workers.celery_app worker -Q qlib_queue ...
CMD ["python"]
