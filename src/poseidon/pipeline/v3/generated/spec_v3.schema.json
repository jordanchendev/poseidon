{
  "$defs": {
    "AllocationSingle": {
      "additionalProperties": false,
      "description": "One sleeve, weight 1.",
      "properties": {
        "component": {
          "const": "allocation.single",
          "title": "Component",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/AllocationSingleParams"
        }
      },
      "required": [
        "component"
      ],
      "title": "allocation.single",
      "type": "object"
    },
    "AllocationSingleParams": {
      "additionalProperties": false,
      "properties": {},
      "title": "AllocationSingleParams",
      "type": "object"
    },
    "Capital": {
      "additionalProperties": false,
      "properties": {
        "initial_twd": {
          "default": 1000000,
          "maximum": 20000000,
          "minimum": 300000,
          "title": "Initial Twd",
          "type": "number"
        }
      },
      "title": "Capital",
      "type": "object"
    },
    "DirectionConstant": {
      "additionalProperties": false,
      "description": "Always long or always short; the leverage chain then decides how much.",
      "properties": {
        "component": {
          "const": "direction.constant",
          "title": "Component",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/DirectionConstantParams"
        }
      },
      "required": [
        "component"
      ],
      "title": "direction.constant",
      "type": "object"
    },
    "DirectionConstantParams": {
      "additionalProperties": false,
      "properties": {
        "side": {
          "enum": [
            "long",
            "short"
          ],
          "title": "Side",
          "type": "string"
        }
      },
      "required": [
        "side"
      ],
      "title": "DirectionConstantParams",
      "type": "object"
    },
    "DirectionDslRules": {
      "additionalProperties": false,
      "description": "DSL v2.1 intraday rules for TX/MTX (sessions, opening range, EMA/SMA/ATR/RSI, N-bar channels, exits in the DSL risk block); 1 fixed contract, fills at the signal bar's close.",
      "properties": {
        "component": {
          "const": "direction.dsl_rules",
          "title": "Component",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "description": "a DSL v2 document without symbol/market/interval/params (see the DSL v2 schema)",
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "component",
        "params"
      ],
      "title": "direction.dsl_rules",
      "type": "object"
    },
    "ExecutionNextOpen": {
      "additionalProperties": false,
      "description": "Decide after the daily close, fill at the next session's open (TX family: 15:00 night open).",
      "properties": {
        "component": {
          "const": "execution.next_open",
          "title": "Component",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/ExecutionNextOpenParams"
        }
      },
      "required": [
        "component"
      ],
      "title": "execution.next_open",
      "type": "object"
    },
    "ExecutionNextOpenParams": {
      "additionalProperties": false,
      "properties": {},
      "title": "ExecutionNextOpenParams",
      "type": "object"
    },
    "ExecutionSignalClose": {
      "additionalProperties": false,
      "description": "Fill at the signal bar's close; only for direction.dsl_rules (DSL v2 parity).",
      "properties": {
        "component": {
          "const": "execution.signal_close",
          "title": "Component",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/ExecutionSignalCloseParams"
        }
      },
      "required": [
        "component"
      ],
      "title": "execution.signal_close",
      "type": "object"
    },
    "ExecutionSignalCloseParams": {
      "additionalProperties": false,
      "properties": {},
      "title": "ExecutionSignalCloseParams",
      "type": "object"
    },
    "InstrumentDecl": {
      "additionalProperties": false,
      "properties": {
        "roll": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "roll.at_settlement": "#/$defs/RollAtSettlement",
                  "roll.before_settlement": "#/$defs/RollBeforeSettlement"
                },
                "propertyName": "component"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/RollBeforeSettlement"
                },
                {
                  "$ref": "#/$defs/RollAtSettlement"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Roll"
        },
        "symbol": {
          "enum": [
            "TX",
            "MTX",
            "TMF"
          ],
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "symbol"
      ],
      "title": "InstrumentDecl",
      "type": "object"
    },
    "LeverageBase": {
      "additionalProperties": false,
      "description": "Base leverage L0 = value x equity (first link of the leverage chain).",
      "properties": {
        "component": {
          "const": "leverage.base",
          "title": "Component",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/LeverageBaseParams"
        }
      },
      "required": [
        "component"
      ],
      "title": "leverage.base",
      "type": "object"
    },
    "LeverageBaseParams": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 5.0,
              "type": "number"
            },
            {
              "$ref": "#/$defs/ParamRef"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value"
      ],
      "title": "LeverageBaseParams",
      "type": "object"
    },
    "ParamRef": {
      "additionalProperties": false,
      "description": "``{\"$param\": \"<name>\"}``: the value is the tunable spec-level parameter ``<name>``.",
      "properties": {
        "$param": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "$Param",
          "type": "string"
        }
      },
      "required": [
        "$param"
      ],
      "title": "ParamRef",
      "type": "object"
    },
    "ParamSpec": {
      "additionalProperties": false,
      "description": "A tunable parameter. Values are restricted to ``low + k * step`` (grid).",
      "properties": {
        "default": {
          "title": "Default",
          "type": "number"
        },
        "high": {
          "title": "High",
          "type": "number"
        },
        "low": {
          "title": "Low",
          "type": "number"
        },
        "step": {
          "title": "Step",
          "type": "number"
        },
        "type": {
          "enum": [
            "int",
            "float"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "low",
        "high",
        "step",
        "default"
      ],
      "title": "ParamSpec",
      "type": "object"
    },
    "RebalanceDaily": {
      "additionalProperties": false,
      "description": "Re-size every trading day when the target differs by at least min_change_units.",
      "properties": {
        "component": {
          "const": "rebalance.daily",
          "title": "Component",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/RebalanceDailyParams"
        }
      },
      "required": [
        "component"
      ],
      "title": "rebalance.daily",
      "type": "object"
    },
    "RebalanceDailyParams": {
      "additionalProperties": false,
      "properties": {
        "min_change_units": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "$ref": "#/$defs/ParamRef"
            }
          ],
          "default": 1,
          "title": "Min Change Units"
        }
      },
      "title": "RebalanceDailyParams",
      "type": "object"
    },
    "RebalanceMonthlyAtRoll": {
      "additionalProperties": false,
      "description": "Re-size only when the futures position rolls (monthly); direction changes still trade at once.",
      "properties": {
        "component": {
          "const": "rebalance.monthly_at_roll",
          "title": "Component",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/RebalanceMonthlyAtRollParams"
        }
      },
      "required": [
        "component"
      ],
      "title": "rebalance.monthly_at_roll",
      "type": "object"
    },
    "RebalanceMonthlyAtRollParams": {
      "additionalProperties": false,
      "properties": {
        "min_change_units": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "$ref": "#/$defs/ParamRef"
            }
          ],
          "default": 1,
          "title": "Min Change Units"
        }
      },
      "title": "RebalanceMonthlyAtRollParams",
      "type": "object"
    },
    "RebalanceOnSignalChange": {
      "additionalProperties": false,
      "description": "Trade only when the direction changes (enter / exit / reverse); no re-sizing in between.",
      "properties": {
        "component": {
          "const": "rebalance.on_signal_change",
          "title": "Component",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/RebalanceOnSignalChangeParams"
        }
      },
      "required": [
        "component"
      ],
      "title": "rebalance.on_signal_change",
      "type": "object"
    },
    "RebalanceOnSignalChangeParams": {
      "additionalProperties": false,
      "properties": {},
      "title": "RebalanceOnSignalChangeParams",
      "type": "object"
    },
    "RebalanceThresholdBand": {
      "additionalProperties": false,
      "description": "Re-size when the actual leverage drifts more than band_pct from the target (relative).",
      "properties": {
        "component": {
          "const": "rebalance.threshold_band",
          "title": "Component",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/RebalanceThresholdBandParams"
        }
      },
      "required": [
        "component"
      ],
      "title": "rebalance.threshold_band",
      "type": "object"
    },
    "RebalanceThresholdBandParams": {
      "additionalProperties": false,
      "properties": {
        "band_pct": {
          "anyOf": [
            {
              "maximum": 0.5,
              "minimum": 0.01,
              "type": "number"
            },
            {
              "$ref": "#/$defs/ParamRef"
            }
          ],
          "default": 0.1,
          "title": "Band Pct"
        }
      },
      "title": "RebalanceThresholdBandParams",
      "type": "object"
    },
    "RegimeMaBand": {
      "additionalProperties": false,
      "description": "Moving-average regime with a hysteresis band: below MA x (1 - band) switch to off_leverage, back above MA x (1 + band) restore the incoming leverage.",
      "properties": {
        "component": {
          "const": "regime.ma_band",
          "title": "Component",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/RegimeMaBandParams"
        }
      },
      "required": [
        "component"
      ],
      "title": "regime.ma_band",
      "type": "object"
    },
    "RegimeMaBandParams": {
      "additionalProperties": false,
      "properties": {
        "band_pct": {
          "anyOf": [
            {
              "maximum": 0.1,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "$ref": "#/$defs/ParamRef"
            }
          ],
          "default": 0.02,
          "title": "Band Pct"
        },
        "ma_days": {
          "anyOf": [
            {
              "maximum": 400,
              "minimum": 20,
              "type": "integer"
            },
            {
              "$ref": "#/$defs/ParamRef"
            }
          ],
          "default": 200,
          "title": "Ma Days"
        },
        "off_leverage": {
          "anyOf": [
            {
              "maximum": 5.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "$ref": "#/$defs/ParamRef"
            }
          ],
          "default": 0.5,
          "title": "Off Leverage"
        },
        "signal": {
          "default": "self:adjusted",
          "pattern": "^(self|[a-z][a-z0-9_]{0,31}):(open|high|low|close|adjusted)$",
          "title": "Signal",
          "type": "string"
        }
      },
      "title": "RegimeMaBandParams",
      "type": "object"
    },
    "RiskVolCap": {
      "additionalProperties": false,
      "description": "Volatility cap: leverage = min(incoming, k / annualised realised volatility over window_days).",
      "properties": {
        "component": {
          "const": "risk.vol_cap",
          "title": "Component",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/RiskVolCapParams"
        }
      },
      "required": [
        "component"
      ],
      "title": "risk.vol_cap",
      "type": "object"
    },
    "RiskVolCapParams": {
      "additionalProperties": false,
      "properties": {
        "k": {
          "anyOf": [
            {
              "maximum": 3.0,
              "minimum": 0.1,
              "type": "number"
            },
            {
              "$ref": "#/$defs/ParamRef"
            }
          ],
          "default": 0.75,
          "title": "K"
        },
        "signal": {
          "default": "self:adjusted",
          "pattern": "^(self|[a-z][a-z0-9_]{0,31}):(open|high|low|close|adjusted)$",
          "title": "Signal",
          "type": "string"
        },
        "window_days": {
          "anyOf": [
            {
              "maximum": 120,
              "minimum": 5,
              "type": "integer"
            },
            {
              "$ref": "#/$defs/ParamRef"
            }
          ],
          "default": 20,
          "title": "Window Days"
        }
      },
      "title": "RiskVolCapParams",
      "type": "object"
    },
    "RollAtSettlement": {
      "additionalProperties": false,
      "description": "Intraday R1 futures: synthetic roll on settlement day (13:25 close -> 13:30 open, both legs costed).",
      "properties": {
        "component": {
          "const": "roll.at_settlement",
          "title": "Component",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/RollAtSettlementParams"
        }
      },
      "required": [
        "component"
      ],
      "title": "roll.at_settlement",
      "type": "object"
    },
    "RollAtSettlementParams": {
      "additionalProperties": false,
      "properties": {},
      "title": "RollAtSettlementParams",
      "type": "object"
    },
    "RollBeforeSettlement": {
      "additionalProperties": false,
      "description": "Daily futures: roll to the next contract month days_before trading days before settlement.",
      "properties": {
        "component": {
          "const": "roll.before_settlement",
          "title": "Component",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/RollBeforeSettlementParams"
        }
      },
      "required": [
        "component"
      ],
      "title": "roll.before_settlement",
      "type": "object"
    },
    "RollBeforeSettlementParams": {
      "additionalProperties": false,
      "properties": {
        "days_before": {
          "default": 1,
          "maximum": 5,
          "minimum": 0,
          "title": "Days Before",
          "type": "integer"
        }
      },
      "title": "RollBeforeSettlementParams",
      "type": "object"
    },
    "SizingFixedContracts": {
      "additionalProperties": false,
      "description": "A fixed number of contracts n whenever the direction is non-zero (v1 behaviour).",
      "properties": {
        "component": {
          "const": "sizing.fixed_contracts",
          "title": "Component",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/SizingFixedContractsParams"
        }
      },
      "required": [
        "component"
      ],
      "title": "sizing.fixed_contracts",
      "type": "object"
    },
    "SizingFixedContractsParams": {
      "additionalProperties": false,
      "properties": {
        "n": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 1,
              "type": "integer"
            },
            {
              "$ref": "#/$defs/ParamRef"
            }
          ],
          "default": 1,
          "title": "N"
        }
      },
      "title": "SizingFixedContractsParams",
      "type": "object"
    },
    "SizingTargetLeverage": {
      "additionalProperties": false,
      "description": "Equity-based integer contracts: units = equity x direction x leverage / (price x point value).",
      "properties": {
        "component": {
          "const": "sizing.target_leverage",
          "title": "Component",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/SizingTargetLeverageParams"
        }
      },
      "required": [
        "component"
      ],
      "title": "sizing.target_leverage",
      "type": "object"
    },
    "SizingTargetLeverageParams": {
      "additionalProperties": false,
      "properties": {
        "rounding": {
          "default": "floor",
          "enum": [
            "floor",
            "nearest"
          ],
          "title": "Rounding",
          "type": "string"
        }
      },
      "title": "SizingTargetLeverageParams",
      "type": "object"
    },
    "Sleeve": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "discriminator": {
            "mapping": {
              "direction.constant": "#/$defs/DirectionConstant",
              "direction.dsl_rules": "#/$defs/DirectionDslRules"
            },
            "propertyName": "component"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/DirectionConstant"
            },
            {
              "$ref": "#/$defs/DirectionDslRules"
            }
          ],
          "title": "Direction"
        },
        "exits": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 0,
          "title": "Exits",
          "type": "array"
        },
        "hedges": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 0,
          "title": "Hedges",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "instrument": {
          "title": "Instrument",
          "type": "string"
        },
        "leverage": {
          "items": {
            "discriminator": {
              "mapping": {
                "leverage.base": "#/$defs/LeverageBase",
                "regime.ma_band": "#/$defs/RegimeMaBand",
                "risk.vol_cap": "#/$defs/RiskVolCap"
              },
              "propertyName": "component"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/LeverageBase"
              },
              {
                "$ref": "#/$defs/RegimeMaBand"
              },
              {
                "$ref": "#/$defs/RiskVolCap"
              }
            ]
          },
          "title": "Leverage",
          "type": "array"
        },
        "rebalance": {
          "discriminator": {
            "mapping": {
              "rebalance.daily": "#/$defs/RebalanceDaily",
              "rebalance.monthly_at_roll": "#/$defs/RebalanceMonthlyAtRoll",
              "rebalance.on_signal_change": "#/$defs/RebalanceOnSignalChange",
              "rebalance.threshold_band": "#/$defs/RebalanceThresholdBand"
            },
            "propertyName": "component"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/RebalanceDaily"
            },
            {
              "$ref": "#/$defs/RebalanceMonthlyAtRoll"
            },
            {
              "$ref": "#/$defs/RebalanceThresholdBand"
            },
            {
              "$ref": "#/$defs/RebalanceOnSignalChange"
            }
          ],
          "title": "Rebalance"
        },
        "sizing": {
          "discriminator": {
            "mapping": {
              "sizing.fixed_contracts": "#/$defs/SizingFixedContracts",
              "sizing.target_leverage": "#/$defs/SizingTargetLeverage"
            },
            "propertyName": "component"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/SizingTargetLeverage"
            },
            {
              "$ref": "#/$defs/SizingFixedContracts"
            }
          ],
          "title": "Sizing"
        }
      },
      "required": [
        "id",
        "instrument",
        "direction",
        "sizing",
        "rebalance"
      ],
      "title": "Sleeve",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Spec v3, REGISTRY_VERSION 1. Shape only: cross rules, $param policy (1-4), feasibility and the 5x leverage cap are checked by spec_validate.",
  "properties": {
    "allocation": {
      "$ref": "#/$defs/AllocationSingle"
    },
    "capital": {
      "$ref": "#/$defs/Capital"
    },
    "description": {
      "default": "",
      "maxLength": 500,
      "title": "Description",
      "type": "string"
    },
    "execution": {
      "discriminator": {
        "mapping": {
          "execution.next_open": "#/$defs/ExecutionNextOpen",
          "execution.signal_close": "#/$defs/ExecutionSignalClose"
        },
        "propertyName": "component"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ExecutionNextOpen"
        },
        {
          "$ref": "#/$defs/ExecutionSignalClose"
        }
      ],
      "title": "Execution"
    },
    "frequency": {
      "enum": [
        "1d",
        "1m",
        "5m",
        "15m"
      ],
      "title": "Frequency",
      "type": "string"
    },
    "instruments": {
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,31}$": {
          "$ref": "#/$defs/InstrumentDecl"
        }
      },
      "title": "Instruments",
      "type": "object"
    },
    "name": {
      "pattern": "^[a-z0-9_]{3,64}$",
      "title": "Name",
      "type": "string"
    },
    "params": {
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,31}$": {
          "$ref": "#/$defs/ParamSpec"
        }
      },
      "title": "Params",
      "type": "object"
    },
    "sleeves": {
      "items": {
        "$ref": "#/$defs/Sleeve"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Sleeves",
      "type": "array"
    },
    "spec_version": {
      "const": 3,
      "title": "Spec Version",
      "type": "integer"
    }
  },
  "required": [
    "spec_version",
    "name",
    "frequency",
    "instruments",
    "sleeves",
    "allocation",
    "execution"
  ],
  "title": "Strategy spec v3 (registry 1)",
  "type": "object"
}
