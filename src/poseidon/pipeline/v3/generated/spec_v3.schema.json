        },
        "signal": {
          "pattern": "^((self|[a-z][a-z0-9_]{0,31}):(open|high|low|close|adjusted)|index:(taiex|taiex_tr|vix))$",
          "title": "Signal",
          "type": "string"
        },
        "window_days": {
          "anyOf": [
            {
              "maximum": 120,
              "minimum": 5,
              "type": "integer"
            },
            {
              "$ref": "#/$defs/ParamRef"
            }
          ],
          "default": 20,
          "title": "Window Days"
        }
      },
      "required": [
        "signal"
      ],
      "title": "RiskVolCapParams",
      "type": "object"
