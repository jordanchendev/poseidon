              {
                "$ref": "#/$defs/LeverageBase"
              },
              {
                "$ref": "#/$defs/RegimeMaBand"
              },
              {
                "$ref": "#/$defs/RiskVolCap"
              },
              {
                "$ref": "#/$defs/LeverageDrawdownLadder"
              },
              {
                "$ref": "#/$defs/LeverageLevelLadder"
              }
            ]
          },
          "title": "Leverage",
          "type": "array"
        },
        "rebalance": {
          "discriminator": {
            "mapping": {
              "rebalance.daily": "#/$defs/RebalanceDaily",
              "rebalance.monthly_at_roll": "#/$defs/RebalanceMonthlyAtRoll",
              "rebalance.on_signal_change": "#/$defs/RebalanceOnSignalChange",
              "rebalance.threshold_band": "#/$defs/RebalanceThresholdBand"
            },
            "propertyName": "component"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/RebalanceDaily"
            },
            {
              "$ref": "#/$defs/RebalanceMonthlyAtRoll"
            },
            {
              "$ref": "#/$defs/RebalanceThresholdBand"
            },
            {
              "$ref": "#/$defs/RebalanceOnSignalChange"
            }
          ],
          "title": "Rebalance"
        },
        "sizing": {
          "discriminator": {
            "mapping": {
              "sizing.fixed_contracts": "#/$defs/SizingFixedContracts",
              "sizing.fixed_notional": "#/$defs/SizingFixedNotional",
              "sizing.target_leverage": "#/$defs/SizingTargetLeverage"
            },
            "propertyName": "component"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/SizingTargetLeverage"
            },
            {
              "$ref": "#/$defs/SizingFixedNotional"
            },
            {
              "$ref": "#/$defs/SizingFixedContracts"
            }
          ],
          "title": "Sizing"
        }
      },
      "required": [
        "id",
        "instrument",
        "direction",
        "sizing",
        "rebalance"
      ],
      "title": "Sleeve",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Spec v3, REGISTRY_VERSION 2. Shape only: cross rules, $param policy (1-4), feasibility and the 5x leverage cap are checked by spec_validate.",
  "properties": {
    "allocation": {
      "discriminator": {
        "mapping": {
          "allocation.fixed_weights": "#/$defs/AllocationFixedWeights",
          "allocation.inverse_vol": "#/$defs/AllocationInverseVol",
          "allocation.regime_switch": "#/$defs/AllocationRegimeSwitch",
          "allocation.single": "#/$defs/AllocationSingle"
        },
        "propertyName": "component"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AllocationSingle"
        },
        {
          "$ref": "#/$defs/AllocationFixedWeights"
        },
        {
          "$ref": "#/$defs/AllocationInverseVol"
        },
        {
          "$ref": "#/$defs/AllocationRegimeSwitch"
        }
      ],
      "title": "Allocation"
    },
    "capital": {
      "$ref": "#/$defs/Capital"
    },
    "description": {
      "default": "",
      "maxLength": 500,
      "title": "Description",
      "type": "string"
    },
    "execution": {
      "discriminator": {
        "mapping": {
          "execution.next_open": "#/$defs/ExecutionNextOpen",
          "execution.signal_close": "#/$defs/ExecutionSignalClose"
        },
        "propertyName": "component"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ExecutionNextOpen"
        },
        {
          "$ref": "#/$defs/ExecutionSignalClose"
        }
      ],
      "title": "Execution"
    },
    "frequency": {
      "enum": [
        "1d",
        "1m",
        "5m",
        "15m"
      ],
      "title": "Frequency",
      "type": "string"
    },
    "instruments": {
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,31}$": {
          "$ref": "#/$defs/InstrumentDecl"
        }
      },
      "title": "Instruments",
      "type": "object"
    },
    "name": {
      "pattern": "^[a-z0-9_]{3,64}$",
      "title": "Name",
      "type": "string"
    },
    "params": {
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,31}$": {
          "$ref": "#/$defs/ParamSpec"
        }
      },
      "title": "Params",
      "type": "object"
    },
    "sleeves": {
      "items": {
        "$ref": "#/$defs/Sleeve"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Sleeves",
      "type": "array"
    },
    "spec_version": {
      "const": 3,
      "title": "Spec Version",
      "type": "integer"
    }
  },
  "required": [
    "spec_version",
    "name",
    "frequency",
    "instruments",
    "sleeves",
    "allocation",
    "execution"
  ],
  "title": "Strategy spec v3 (registry 2)",
  "type": "object"
}
