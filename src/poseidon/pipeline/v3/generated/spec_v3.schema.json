            }
          ],
          "default": 1,
          "title": "N"
        }
      },
      "title": "SizingFixedContractsParams",
      "type": "object"
    },
    "SizingFixedNotional": {
      "additionalProperties": false,
      "description": "A fixed share of equity as notional, no leverage chain: units = equity x weight x pct_of_equity% / (price x point value x lot).",
      "properties": {
        "component": {
          "const": "sizing.fixed_notional",
