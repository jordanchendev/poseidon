    "Sleeve": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "discriminator": {
            "mapping": {
              "direction.constant": "#/$defs/DirectionConstant",
              "direction.dsl_rules": "#/$defs/DirectionDslRules"
            },
