        "instrument": {
          "title": "Instrument",
          "type": "string"
        },
        "leverage": {
          "items": {
            "discriminator": {
              "mapping": {
                "leverage.base": "#/$defs/LeverageBase",
                "leverage.drawdown_ladder": "#/$defs/LeverageDrawdownLadder",
