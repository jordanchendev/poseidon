{
  "_comment": "market_brief config. Paths may start with ~. Slot times are local to each slot's tz. US slots fire at fixed Asia/Taipei times all year (owner 2026-11-04); session_tz names the zone whose date and holidays the session follows. In winter 05:15 Taipei is 16:15 New York, so critical US closing data is waited for (complete_wait_minutes). tw-postmarket is 17:45 because TWSE revises the day's turnover totals after 16:30 (seen 2026-10-22).",
  "state_dir": "~/market-brief/state",
  "outbox_dir": "~/market-brief/outbox",
  "watchlist_file": "~/market-brief/watchlist.json",
  "bridge": "ssh research-bridge",
  "window_minutes": 90,
  "complete_wait_minutes": 60,
  "slots": {
    "us-postmarket": {"tz": "Asia/Taipei", "session_tz": "America/New_York", "time": "05:15", "market": "us"},
    "tw-premarket": {"tz": "Asia/Taipei", "time": "08:15", "market": "tw"},
    "tw-postmarket": {"tz": "Asia/Taipei", "time": "17:45", "market": "tw"},
    "us-premarket": {"tz": "Asia/Taipei", "session_tz": "America/New_York", "time": "20:45", "market": "us"}
  },
  "llm": {
    "key_file": "~/research-runner/secrets/research-draft-openrouter.env",
    "key_var": "RESEARCH_DRAFT_OPENROUTER_KEY",
    "model": "deepseek/deepseek-v4.1-flash-1017",
    "reasoning": false,
    "max_tokens": 6000,
    "timeout_s": 180,
    "app_title": "market-brief",
    "app_referer": "https://github.com/jordanchendev/poseidon#market-brief",
    "user": "market-brief"
  },
  "nyse_holidays": {
    "_source": "NYSE holiday rules (Sat -> Fri, Sun -> Mon; New Year's on Sat not observed). Re-check https://www.nyse.com/markets/hours-calendars each December.",
